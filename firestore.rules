rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Estado operacional compartilhado. Dados privados de clientes NÃO devem
    // ser armazenados neste documento.
    match /app_state/main {
      allow read, write: if signedIn();
    }

    // CPF, telefone, endereço e consentimento do cliente.
    // Somente o próprio UID autenticado pode acessar o documento.
    match /customer_private/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
